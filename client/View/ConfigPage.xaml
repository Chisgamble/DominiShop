<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DominiShop.View.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DominiShop.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16" Padding="40">
        <TextBlock Text="Server Configuration" Style="{StaticResource TitleTextBlockStyle}"/>
        <InfoBar IsOpen="{x:Bind ViewModel.ShowRestartMessage, Mode=OneWay}"
                     Severity="Warning"
                     Title="Configuration saved!"
                     Message="Please restart the app to apply the configuration changes."
                     IsClosable="True" />
        
        <TextBox Header="Supabase URL" 
                    PlaceholderText="https://your-project.supabase.co"
                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox Header="Supabase Key" 
                    PlaceholderText="your-api-key"
                    Text="{x:Bind ViewModel.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <PasswordBox x:Name="DbConnBox" 
                        Header="Database Connection String"
                        PlaceholderText="Host=...;Database=...;Username=...;Password=..."
                        PasswordChanged="DbConnBox_PasswordChanged" />

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,0">
            <Button Content="Lưu cấu hình" 
                    Style="{StaticResource AccentButtonStyle}" 
                    Command="{x:Bind ViewModel.SaveCommand}"/>

            <Button Content="Quay lại" 
                     Click="Back_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
