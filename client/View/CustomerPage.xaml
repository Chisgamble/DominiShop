<Page
    x:Class="DominiShop.View.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:DominiShop.Model"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:conv="using:DominiShop.Converter"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:MoneyConverter                   x:Key="MoneyConv"/>
        <conv:BoolNegationConverter            x:Key="InvBool"/>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page title ── -->
        <TextBlock Grid.Row="0"
                   Text="Customers"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- ── Tab selector ── -->
        <TabView Grid.Row="1"
                 IsAddTabButtonVisible="False"
                 Margin="0,0,0,12"
                 SelectionChanged="OnTabChanged">
            <TabViewItem Header="Customer List"
                         IsClosable="False"
                         Tag="customers"/>
            <TabViewItem Header="Member Tiers"
                         IsClosable="False"
                         Tag="tiers"/>
        </TabView>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  CUSTOMER LIST TAB                                                  -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ViewModel.IsTierTab, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">

                    <AutoSuggestBox PlaceholderText="Search name, phone, email..."
                                    QueryIcon="Find"
                                    Width="260"
                                    Height="36"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.TierFilterOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedTierFilter, Mode=TwoWay}"
                              Width="160"
                              Height="36"
                              VerticalAlignment="Center"
                              PlaceholderText="Tier"/>

                    <ComboBox ItemsSource="{x:Bind ViewModel.SortOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                              Width="180"
                              Height="36"
                              VerticalAlignment="Center"
                              PlaceholderText="Sort by"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="12,0"
                        Click="OnAddCustomerClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                        <TextBlock Text="Add customer"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Loading indicator -->
            <ProgressRing Grid.Row="1"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="48"
                          Height="48"/>

            <!-- DataGrid -->
            <controls:DataGrid
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.FilteredCustomers, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                AutoGenerateColumns="False"
                GridLinesVisibility="Horizontal"
                IsReadOnly="True"
                SelectionMode="Single"
                CanUserSortColumns="True"
                RowHeight="52"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvBoolToVis}}">

                <controls:DataGrid.Columns>

                    <!-- Name -->
                    <controls:DataGridTextColumn Header="Customer Name"
                                                 Binding="{Binding Username}"
                                                 Width="180"
                                                 CanUserSort="True"/>

                    <!-- Phone -->
                    <controls:DataGridTextColumn Header="Phone Number"
                                                 Binding="{Binding Phone}"
                                                 Width="140"/>

                    <!-- Email -->
                    <controls:DataGridTextColumn Header="Email"
                                                 Binding="{Binding Email}"
                                                 Width="200"/>

                    <!-- Tier -->
                    <controls:DataGridTemplateColumn Header="Tier"
                                                     Width="130"
                                                     CanUserSort="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="model:Customer">
                                <TextBlock Text="{Binding Tier.Name}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemAccentColor}"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- Points -->
                    <controls:DataGridTextColumn Header="Total Points"
                                                 Binding="{Binding TotalPoints}"
                                                 Width="110"
                                                 CanUserSort="True"/>

                    <!-- Address -->
                    <controls:DataGridTextColumn Header="Address"
                                                 Binding="{Binding Address}"
                                                 Width="*"/>

                    <!-- Actions -->
                    <controls:DataGridTemplateColumn Header="" Width="100">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="model:Customer">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Background="Transparent"
                                            ToolTipService.ToolTip="Details"
                                            Padding="8,4"
                                            Click="OnViewCustomerRowClick">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                    </Button>
                                    <Button Background="Transparent"
                                            ToolTipService.ToolTip="Delete"
                                            Padding="8,4"
                                            Click="OnDeleteCustomerRowClick">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                </controls:DataGrid.Columns>
            </controls:DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15" Margin="0,15,0,0">
                <TextBlock Text="Items per page:" VerticalAlignment="Center" Foreground="Gray"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.PageSizeOptions}" 
                          SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}" 
                          Width="80" Height="32"/>

                <StackPanel Orientation="Horizontal" Spacing="5" Margin="20,0,0,0">
                    <Button Command="{x:Bind ViewModel.PreviousPageCommand}" 
                            IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}" 
                            Width="36" Height="32" ToolTipService.ToolTip="Previous Page">
                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                    </Button>

                    <TextBlock Text="{x:Bind ViewModel.PagingInfo, Mode=OneWay}" 
                               VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/>

                    <Button Command="{x:Bind ViewModel.NextPageCommand}" 
                            IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}" 
                            Width="36" Height="32" ToolTipService.ToolTip="Next Page">
                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  TIER MANAGEMENT TAB                                                -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ViewModel.IsTierTab, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Configure customer tiers based on accumulated points."
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="12,0"
                        Click="OnAddTierClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                        <TextBlock Text="Add new tier"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Tier cards -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredTiers, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="model:CustomerTier">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="20,16"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tier badge -->
                                    <Border Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="{ThemeResource SystemAccentColor}"
                                            Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE734;"
                                                  FontSize="20"
                                                  Foreground="White"/>
                                    </Border>

                                    <!-- Name + threshold -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="From "/>
                                            <Run Text="{Binding MinPoint}"/>
                                            <Run Text=" points"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Discount % -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,32,0">
                                        <TextBlock Text="Discount"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource SystemAccentColor}">
                                            <Run Text="{Binding Percent}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Edit button -->
                                    <Button Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Padding="10,6"
                                            Click="OnEditTierClick">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon Glyph="&#xE70F;"
                                                      FontSize="13"/>
                                            <TextBlock Text="Edit"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Grid.Column="4"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            Padding="10,6"
                                            Click="OnDeleteTierClick">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="Red"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!--  DIALOGS                                                            -->
        <!-- ════════════════════════════════════════════════════════════════════ -->

        <!-- Customer detail dialog -->
        <ContentDialog x:Name="CustomerDetailDialog"
                       Title="Customer Details"
                       PrimaryButtonText="Edit"
                       SecondaryButtonText="Delete"
                       CloseButtonText="Close"
                       DefaultButton="Primary">
            <StackPanel Spacing="14"
                        Margin="0,10,0,0"
                        Width="380"
                        Visibility="{x:Bind ViewModel.HasSelectedCustomer, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <!-- Name + tier badge -->
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="24"
                            Background="{ThemeResource SystemAccentColorLight2}">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="22"
                                  Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Username, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Tier.Name, Mode=OneWay, FallbackValue='(No tier)'}"
                                   FontSize="13"
                                   Foreground="{ThemeResource SystemAccentColor}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phone Number"
                                   Foreground="Gray"
                                   FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Phone, Mode=OneWay}"
                                   FontSize="15"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Email"
                                   Foreground="Gray"
                                   FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Email, Mode=OneWay}"
                                   FontSize="15"/>
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Text="Address"
                               Foreground="Gray"
                               FontSize="12"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Address, Mode=OneWay}"
                               FontSize="15"/>
                </StackPanel>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Points"
                                   Foreground="Gray"
                                   FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.TotalPoints, Mode=OneWay}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource SystemAccentColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Created Date"
                                   Foreground="Gray"
                                   FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.CreatedAt, Mode=OneWay}"
                                   FontSize="14"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ContentDialog>

        <!-- Customer Add/Edit dialog -->
        <ContentDialog x:Name="CustomerEditDialog"
                       Title="{x:Bind GetCustomerDialogTitle(ViewModel.IsEditMode), Mode=OneWay}"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnSaveCustomerDialogClick">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Width="400"
                          MaxHeight="520">
                <StackPanel Spacing="16"
                            Margin="0,10,16,10">

                    <InfoBar x:Name="CustomerErrorBanner"
                             IsOpen="False"
                             Severity="Error"
                             IsClosable="False"
                             Margin="0,0,0,4"/>

                    <TextBox Header="Customer Name *"
                             PlaceholderText="Enter name..."
                             Text="{x:Bind ViewModel.EditingCustomer.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Header="Phone Number *"
                             PlaceholderText="Enter phone number..."
                             InputScope="TelephoneNumber"
                             IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource InvBool}}"
                             Text="{x:Bind ViewModel.EditingCustomer.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Header="Email *"
                             PlaceholderText="example@email.com"
                             InputScope="EmailSmtpAddress"
                             Text="{x:Bind ViewModel.EditingCustomer.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Header="Address"
                             PlaceholderText="Enter address (optional)..."
                             Text="{x:Bind ViewModel.EditingCustomer.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Header="Member Tier"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Select tier"
                              ItemsSource="{x:Bind ViewModel.TierList}"
                              SelectedIndex="{x:Bind ViewModel.EditingTierIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:CustomerTier">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- Tier Add/Edit dialog -->
        <ContentDialog x:Name="TierEditDialog"
                       Title="{x:Bind GetTierDialogTitle(ViewModel.IsTierEditMode), Mode=OneWay}"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnSaveTierDialogClick">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Width="380"
                          MaxHeight="440">
                <StackPanel Spacing="16"
                            Margin="0,10,16,10">

                    <InfoBar x:Name="TierErrorBanner"
                             IsOpen="False"
                             Severity="Error"
                             IsClosable="False"
                             Margin="0,0,0,4"/>

                    <TextBox Header="Tier Name *"
                             PlaceholderText="e.g., Gold, Platinum..."
                             Text="{x:Bind ViewModel.EditingTier.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <NumberBox Header="Minimum Points *"
                               Minimum="0"
                               PlaceholderText="Enter points"
                               Value="{x:Bind ViewModel.EditingTierMinPoint, Mode=TwoWay}"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="100"
                               LargeChange="1000"/>

                    <NumberBox Header="Discount Percentage (0 - 100)"
                               Minimum="0"
                               Maximum="100"
                               PlaceholderText="e.g., 5"
                               Value="{x:Bind ViewModel.EditingTierPercent, Mode=TwoWay}"
                               SpinButtonPlacementMode="Hidden"/>

                    <InfoBar IsOpen="True"
                             Severity="Informational"
                             IsClosable="False"
                             Message="Customers will be automatically upgraded when their total points reach the tier's minimum requirement."/>

                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    
    </Grid>
</Page>
