<Page
    x:Class="DominiShop.View.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:DominiShop.Model"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Stat card style -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

            <!-- ── Page header ──────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Error banner ─────────────────────────────────────────── -->
            <InfoBar x:Name="ErrorInfoBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"/>

            <!-- ── Loading indicator ────────────────────────────────────── -->
            <ProgressBar x:Name="LoadingBar"
                         IsIndeterminate="True"
                         Visibility="Collapsed"/>

            <!-- ── Summary stat cards ────────────────────────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Products -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Products" Style="{StaticResource StatLabelStyle}" Margin="0"/>
                            <Border Grid.Column="1"
                                    Background="#1A6B8AFD"
                                    CornerRadius="8"
                                    Padding="8">
                                <FontIcon Glyph="&#xE719;" FontSize="16" Foreground="#6B8AFD"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TotalProductsText"
                                   Text="—"
                                   Style="{StaticResource StatValueStyle}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Active products in catalog"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Today Orders -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Orders Today" Style="{StaticResource StatLabelStyle}" Margin="0"/>
                            <Border Grid.Column="1"
                                    Background="#1A4CAF50"
                                    CornerRadius="8"
                                    Padding="8">
                                <FontIcon Glyph="&#xE9F3;" FontSize="16" Foreground="#4CAF50"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TodayOrdersText"
                                   Text="—"
                                   Style="{StaticResource StatValueStyle}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Orders placed today"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Today Revenue -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Revenue Today" Style="{StaticResource StatLabelStyle}" Margin="0"/>
                            <Border Grid.Column="1"
                                    Background="#1AFF9800"
                                    CornerRadius="8"
                                    Padding="8">
                                <FontIcon Glyph="&#xE8C7;" FontSize="16" Foreground="#FF9800"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TodayRevenueText"
                                   Text="—"
                                   Style="{StaticResource StatValueStyle}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Total revenue for today"
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Top Product + Revenue line chart (side by side) ─────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Best Selling Product Highlight card -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="12">

                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#1AFF9800" CornerRadius="8" Padding="8">
                                <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="#FF9800"/>
                            </Border>
                            <TextBlock Text="Best Selling"
                           Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"
                           Margin="0"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Height="1"
                       Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                       Opacity="0.5"/>

                        <!-- Product name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="TOP PRODUCT"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="80"/>
                            <TextBlock x:Name="TopProductNameText"
                           Text="—"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Today's revenue for that product -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="TODAY'S REVENUE"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           CharacterSpacing="80"/>
                            <TextBlock x:Name="TopProductRevenueText"
                           Text="—"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FF9800"/>
                        </StackPanel>

                        <!-- Decorative bar -->
                        <Border Background="#1AFF9800"
                    CornerRadius="6"
                    Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C7;" FontSize="12" Foreground="#FF9800"/>
                                <TextBlock Text="All-time best seller"
                               FontSize="11"
                               Foreground="#FF9800"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Revenue line chart -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Daily Revenue (Last 30 Days)"
                       Style="{StaticResource SectionTitleStyle}"/>
                        <Canvas x:Name="RevenueChartCanvas"
                    Height="200"
                    HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── Low stock + Best selling (side by side) ──────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Low Stock -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#E53935"/>
                            <TextBlock Text="Low Stock (qty &lt; 5)"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"/>
                        </StackPanel>

                        <ListView x:Name="LowStockListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Product">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="#1AE53935"
                                                CornerRadius="12"
                                                Padding="8,2">
                                            <TextBlock Foreground="#E53935"
                                                       FontWeight="SemiBold"
                                                       FontSize="12">
                                                <Run Text="Qty: "/>
                                                <Run Text="{x:Bind Quantity}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="LowStockEmptyText"
                                   Text="All products are well stocked ✓"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   Margin="0,12"/>
                    </StackPanel>
                </Border>

                <!-- Best Selling -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                            <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="#FF9800"/>
                            <TextBlock Text="Top 5 Best Selling"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"/>
                        </StackPanel>

                        <ListView x:Name="BestSellingListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Product">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="#1AFF9800"
                                                CornerRadius="12"
                                                Padding="8,2">
                                            <TextBlock Foreground="#FF9800"
                                                       FontWeight="SemiBold"
                                                       FontSize="12">
                                                <Run Text="Sold: "/>
                                                <Run Text="{x:Bind Sold}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="BestSellingEmptyText"
                                   Text="No sales data available yet."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   Margin="0,12"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
