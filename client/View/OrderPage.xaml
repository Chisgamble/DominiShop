<Page
    x:Class="DominiShop.View.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:DominiShop.Model"
    xmlns:vm="using:DominiShop.ViewModel"
    xmlns:conv="using:DominiShop.Converter"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <conv:MoneyConverter x:Key="MoneyConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ MASTER PANEL (LEFT) ============ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Order Management" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <AutoSuggestBox Grid.Row="0" Grid.Column="1" PlaceholderText="Search ID/Phone..." QueryIcon="Find" Height="36" Margin="20,0"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Height="36" Padding="12,0" Click="OnAddOrderClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add Order"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="20,8,0,0">
                    <CalendarDatePicker PlaceholderText="Min Date" Date="{x:Bind ViewModel.MinDate, Mode=TwoWay}" Width="150"/>
                    <CalendarDatePicker PlaceholderText="Max Date" Date="{x:Bind ViewModel.MaxDate, Mode=TwoWay}" Width="150"/>
                </StackPanel>
            </Grid>

            <controls:DataGrid Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.FilteredOrders, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=TwoWay}"
                AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                IsReadOnly="True" SelectionMode="Single" RowHeight="48" HorizontalAlignment="Stretch">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <controls:DataGridTextColumn Header="Date" Binding="{Binding FormattedOrderDate}" Width="140"/>
                    <controls:DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhone}" Width="120"/>
                    <controls:DataGridTemplateColumn Header="Status" Width="100">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="model:Order">
                                <Button Background="{x:Bind StatusColor, Mode=OneWay}" 
                                        CornerRadius="4" Padding="8,2" 
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Click="OnCycleStatusClick" Tag="{x:Bind}" BorderThickness="0">
                                    <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Foreground="White" FontSize="12"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="100"/>
                    <controls:DataGridTemplateColumn Header="Total" Width="*">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="model:Order">
                                <TextBlock Text="{x:Bind FormattedTotal}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Width="70">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="model:Order">
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                                        Background="Transparent" BorderThickness="0" Foreground="Red"
                                        Click="OnDeleteOrderClick" Tag="{x:Bind}"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- ============ DETAIL PANEL (RIGHT) ============ -->
        <Grid Grid.Column="1" Margin="12,0,0,0">

        <!-- No selection placeholder -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20"
                Visibility="{x:Bind ViewModel.SelectedOrder, Mode=OneWay, Converter={StaticResource NullToCollapsed}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE7B8;" FontSize="48" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="Select an order to view details" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Detail content -->
        <ScrollViewer Padding="20"
                      Visibility="{x:Bind ViewModel.SelectedOrder, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <StackPanel Spacing="16">
                <!-- Order ID & Actions -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedOrder.Id, Mode=OneWay, FallbackValue=''}"
                                   FontSize="28" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="Order ID" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="&#xE159;" FontFamily="Segoe MDL2 Assets"
                                FontSize="16" Width="40" Height="40" CornerRadius="20"
                                ToolTipService.ToolTip="Export PDF"
                                Click="OnExportOrderPdfClick"/>
                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" 
                                FontSize="16" Width="40" Height="40" CornerRadius="20"
                                ToolTipService.ToolTip="Edit Order"
                                Click="OnEditOrderClick"/>
                    </StackPanel>
                </Grid>

                <!-- Key-Value Info -->
                <Grid ColumnSpacing="8" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Date:" Foreground="Gray"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedOrder.FormattedOrderDate, Mode=OneWay, FallbackValue=''}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" Foreground="Gray"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedOrder.StatusLabel, Mode=OneWay, FallbackValue=''}" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer:" Foreground="Gray"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedOrderCustomerName, Mode=OneWay}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Phone:" Foreground="Gray"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedOrder.CustomerPhone, Mode=OneWay, FallbackValue=''}"/>
                </Grid>

                <MenuFlyoutSeparator/>

                <!-- Order Items -->
                <TextBlock Text="Items" FontWeight="SemiBold" FontSize="14"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedOrder.OrderDetails, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="model:OrderDetail">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ProductName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" Foreground="Gray"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSubTotal}" FontWeight="SemiBold" MinWidth="80" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <MenuFlyoutSeparator/>

                <!-- Vouchers & Tier -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Voucher" FontWeight="SemiBold" FontSize="14"/>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedOrder.OrderVouchers, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="model:OrderVoucher">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="Green"/>
                                        <TextBlock Text="{x:Bind VoucherCode}"/>
                                        <TextBlock Text="{x:Bind VoucherDiscount}" Foreground="Green" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Tier" FontWeight="SemiBold" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="Goldenrod"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedOrderCustomerTier, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedOrderCustomerTierDiscount, Mode=OneWay}" Foreground="Goldenrod" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Taxes -->
                <TextBlock Text="Tax" FontWeight="SemiBold" FontSize="14"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedOrder.OrderTaxes, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="model:OrderTax">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind TaxName}"/>
                                <TextBlock Text="{x:Bind TaxFormattedValue}" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Shipping -->
                <StackPanel Visibility="{x:Bind ViewModel.SelectedOrder.IsOnline, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <MenuFlyoutSeparator Margin="0,4"/>
                    <TextBlock Text="Shipping" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedOrder.Address, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Shipping fee:" Foreground="Gray"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedOrder.FormattedShippingFee, Mode=OneWay, FallbackValue=''}"/>
                    </StackPanel>
                </StackPanel>

                <MenuFlyoutSeparator/>

                <!-- Grand Total -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <TextBlock Text="Grand Total:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedOrder.FormattedTotal, Mode=OneWay, FallbackValue=''}"
                               FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- ============ STEP 1 DIALOG: CUSTOMER ============ -->
        <ContentDialog x:Name="Step1Dialog" Title="{x:Bind ViewModel.WizardTitle, Mode=OneWay}"
                       PrimaryButtonText="Next" CloseButtonText="Cancel"
                       DefaultButton="Primary" PrimaryButtonClick="OnStep1Next">
            <StackPanel Spacing="12" Width="400">
                <InfoBar x:Name="Step1Error" IsOpen="False" Severity="Error" IsClosable="False"/>

                <AutoSuggestBox PlaceholderText="Search by name or phone..."
                                Text="{x:Bind ViewModel.CustomerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.SuggestedCustomers}"
                                SuggestionChosen="OnCustomerChosen" QueryIcon="Find" TextMemberPath="Username">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="model:Customer">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind Phone}" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <StackPanel Visibility="{x:Bind ViewModel.SelectedCustomer, Mode=OneWay, Converter={StaticResource NullToVis}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12" Spacing="4">
                    <TextBlock Text="Selected customer:" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Username, Mode=OneWay, FallbackValue=''}"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Email, Mode=OneWay, FallbackValue=''}" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Phone, Mode=OneWay, FallbackValue=''}" Foreground="Gray" FontSize="12"/>
                </StackPanel>

                <HyperlinkButton Content="{x:Bind GetToggleCustomerText(ViewModel.IsCreatingNewCustomer), Mode=OneWay}"
                                 Command="{x:Bind ViewModel.ToggleCreateCustomerCommand}"/>

                <StackPanel Visibility="{x:Bind ViewModel.IsCreatingNewCustomer, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Spacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock Text="New Customer" FontWeight="SemiBold"/>
                    <TextBox Header="Name" Text="{x:Bind ViewModel.NewCustomerName, Mode=TwoWay}"/>
                    <TextBox Header="Email" Text="{x:Bind ViewModel.NewCustomerEmail, Mode=TwoWay}"/>
                    <TextBox Header="Phone" Text="{x:Bind ViewModel.NewCustomerPhone, Mode=TwoWay}"/>
                    <ComboBox Header="Tier" 
                              ItemsSource="{x:Bind ViewModel.AvailableCustomerTiers}"
                              SelectedItem="{x:Bind ViewModel.SelectedNewCustomerTier, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Default password: 123456" Foreground="Gray" FontSize="12" FontStyle="Italic"/>
                    <Button Content="Create" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                            Click="OnCreateCustomerClick"/>
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- ============ STEP 2 DIALOG: PRODUCTS ============ -->
        <ContentDialog x:Name="Step2Dialog" Title="{x:Bind ViewModel.WizardTitle, Mode=OneWay}"
                       PrimaryButtonText="Next" SecondaryButtonText="Back" CloseButtonText="Cancel"
                       DefaultButton="Primary" PrimaryButtonClick="OnStep2Next" SecondaryButtonClick="OnStep2Back">
            <Grid Width="500" Height="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <InfoBar x:Name="Step2Error" IsOpen="False" Severity="Error" IsClosable="False" Grid.Row="0" Margin="0,0,0,8"/>

                <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox Grid.Column="0" PlaceholderText="Search products..." QueryIcon="Find"
                                    Text="{x:Bind ViewModel.ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.ProductFilterCategories}"
                              SelectedItem="{x:Bind ViewModel.SelectedProductCategory, Mode=TwoWay}"
                              DisplayMemberPath="Name" Width="140" PlaceholderText="Category"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredAvailableProducts, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:Product">
                            <Grid Padding="4,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind FormattedPrice}" FontSize="12" Foreground="Gray"/>
                                        <TextBlock FontSize="12" Foreground="Gray">
                                            <Run Text="Stock:"/>
                                            <Run Text="{x:Bind Quantity}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="−" Width="32" Height="32" Click="OnDecrementClick" Tag="{x:Bind}" IsEnabled="{x:Bind CanDecrement, Mode=OneWay}"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center" FontWeight="Bold"
                                           Text="{x:Bind CartQuantity, Mode=OneWay}"/>
                                <Button Grid.Column="3" Content="+" Width="32" Height="32" Click="OnIncrementClick" Tag="{x:Bind}" IsEnabled="{x:Bind CanIncrement, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Cart Summary -->
                <StackPanel Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="6" Padding="12" Margin="0,8,0,0">
                    <TextBlock Text="Cart" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartItem">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ProductName, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                    <TextBlock Grid.Column="1" FontSize="12" Foreground="Gray">
                                        <Run Text="x"/>
                                        <Run Text="{x:Bind Quantity, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedSubTotal, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ContentDialog>

        <!-- ============ STEP 3 DIALOG: VOUCHER, TAX, SHIPPING ============ -->
        <ContentDialog x:Name="Step3Dialog" Title="{x:Bind ViewModel.WizardTitle, Mode=OneWay}"
                       PrimaryButtonText="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" SecondaryButtonText="Back" CloseButtonText="Cancel"
                       DefaultButton="Primary" PrimaryButtonClick="OnSubmitOrder" SecondaryButtonClick="OnStep3Back">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Width="450" MaxHeight="550">
                <StackPanel Spacing="14">
                    <InfoBar x:Name="Step3Error" IsOpen="False" Severity="Error" IsClosable="False"/>

                    <!-- Voucher -->
                    <TextBlock Text="Voucher" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{x:Bind ViewModel.AvailableVouchers}"
                              SelectedItem="{x:Bind ViewModel.SelectedVoucher, Mode=TwoWay}"
                              SelectionMode="Single" MaxHeight="120">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Voucher">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                    <TextBlock Text="{x:Bind Code}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind DisplayDiscount}" Foreground="Green"/>
                                    <TextBlock Text="{x:Bind DisplayExpiry}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <MenuFlyoutSeparator/>

                    <!-- Tax -->
                    <TextBlock Text="Tax" FontWeight="SemiBold"/>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvailableTaxes, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaxSelection">
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Click="OnTaxCheckChanged">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind TaxName}"/>
                                        <TextBlock Text="{x:Bind FormattedValue}" Foreground="Gray"/>
                                        <TextBlock Text="{x:Bind AutoLabel}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <MenuFlyoutSeparator/>

                    <!-- Online Shipping -->
                    <CheckBox Content="Online delivery" IsChecked="{x:Bind ViewModel.IsOnlineOrder, Mode=TwoWay}"/>
                    <StackPanel Visibility="{x:Bind ViewModel.IsOnlineOrder, Mode=OneWay, Converter={StaticResource BoolToVis}}" Spacing="8">
                        <TextBox Header="Delivery address" Text="{x:Bind ViewModel.ShippingAddress, Mode=TwoWay}" TextWrapping="Wrap"/>
                        <NumberBox Header="Shipping fee (₫)" Value="{x:Bind ViewModel.ShippingFeeInput, Mode=TwoWay}"
                                   Minimum="0" SpinButtonPlacementMode="Inline" SmallChange="1000"/>
                    </StackPanel>

                    <MenuFlyoutSeparator/>

                    <!-- Summary -->
                    <TextBlock Text="Tổng kết" FontWeight="SemiBold" FontSize="14"/>
                    <Grid RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FormattedSubTotal, Mode=OneWay}" TextAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Voucher Discount:" Foreground="Green"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FormattedDiscount, Mode=OneWay}" Foreground="Green" TextAlignment="Right"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tier Discount:" Foreground="Goldenrod"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.FormattedTierDiscount, Mode=OneWay}" Foreground="Goldenrod" TextAlignment="Right"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tax:"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.FormattedTax, Mode=OneWay}" TextAlignment="Right"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Shipping:"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.FormattedShipping, Mode=OneWay}" TextAlignment="Right"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="GRAND TOTAL:" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.FormattedGrandTotal, Mode=OneWay}"
                                   FontWeight="Bold" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
