<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DominiShop.View.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DominiShop.View"
    xmlns:model="using:DominiShop.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Filters -->
            <RowDefinition Height="*"/>    <!-- Charts -->
            <RowDefinition Height="Auto"/> <!-- AI Placeholder -->
        </Grid.RowDefinitions>

        <!-- Header & Filters -->
        <StackPanel Grid.Row="0" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Report &amp; Analytics" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.TimeFilters, Mode=OneWay}" 
                          SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                          Width="200" VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            Visibility="{x:Bind IsCustomDateVisible(ViewModel.SelectedFilter), Mode=OneWay}">
                    <DatePicker SelectedDate="{x:Bind ViewModel.StartDate, Mode=TwoWay}"/>
                    <TextBlock Text="to" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{x:Bind ViewModel.EndDate, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- Product Search and Active Filters -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <AutoSuggestBox x:Name="ProductSearchBox"
                                PlaceholderText="Search product to compare..."
                                Width="300"
                                TextChanged="ProductSearchBox_TextChanged"
                                SuggestionChosen="ProductSearchBox_SuggestionChosen"
                                DisplayMemberPath="Name"
                                VerticalAlignment="Center"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveProducts, Mode=OneWay}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:Product">
                            <Border Background="{ThemeResource SystemAccentColorLight3}" CornerRadius="4" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                            Background="Transparent" BorderThickness="0" 
                                            Padding="4" MinWidth="0" MinHeight="0"
                                            VerticalAlignment="Center"
                                            Click="RemoveFilter_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Charts Grid -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Line Chart: Products & Sales -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Products &amp; Sales Quantity" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Grid.Row="1" 
                                        Series="{x:Bind ViewModel.SalesSeries, Mode=OneWay}" 
                                        XAxes="{x:Bind ViewModel.SalesXAxes, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Bar Chart: Revenue & Profit -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Revenue &amp; Profit" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Grid.Row="1" 
                                        Series="{x:Bind ViewModel.RevenueSeries, Mode=OneWay}"
                                        XAxes="{x:Bind ViewModel.RevenueXAxes, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- AI Placeholder -->
        <Border Grid.Row="2" Background="{ThemeResource SystemAccentColorLight3}" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="AI Report Analysis ✨" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                    <TextBlock Text="Unlock deeper insights by analyzing these charts with AI. Get recommendations and detailed summaries." 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Analyze with AI" Style="{StaticResource AccentButtonStyle}" 
                        Click="AnalyzeWithAI_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
