<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DominiShop.View.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DominiShop.View"
    xmlns:model="using:DominiShop.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <SplitView IsPaneOpen="{x:Bind ViewModel.IsChatVisible, Mode=TwoWay}" DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="700">
        <SplitView.Pane>
            <Grid Padding="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.CloseChatCommand}" ToolTipService.ToolTip="Close"/>
                        <TextBlock Text="AI Assistant" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="ClearChatButton"
                            Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Clear chat history"
                            Click="ClearChat_Click"/>
                </Grid>

                <Button Grid.Row="1" Content="Export Data for Analysis" Style="{StaticResource AccentButtonStyle}" Click="ExportData_Click" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <ListView x:Name="ChatListView" Grid.Row="2" ItemsSource="{x:Bind ViewModel.ChatMessages, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:ChatMessage">
                            <StackPanel Margin="0,8" HorizontalAlignment="{x:Bind Alignment}">
                                <TextBlock Text="{x:Bind Role}" HorizontalAlignment="{x:Bind Alignment}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="12">
                                    <controls:MarkdownTextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12" Visibility="{x:Bind ViewModel.IsTypingVisibility, Mode=OneWay}">
                            <ProgressRing IsActive="True" Width="16" Height="16"/>
                            <TextBlock Text="AI is typing..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListView.Footer>
                </ListView>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.CurrentChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ask AI something..." Margin="0,0,8,0" VerticalAlignment="Center" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"/>
                    <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SendMessageCommand}" VerticalAlignment="Stretch"/>
                </Grid>
            </Grid>
        </SplitView.Pane>
        <SplitView.Content>
            <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Filters -->
            <RowDefinition Height="*"/>    <!-- Charts -->
        </Grid.RowDefinitions>

        <!-- Header & Filters -->
        <StackPanel Grid.Row="0" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="Report &amp; Analytics" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.TimeFilters, Mode=OneWay}" 
                          SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                          Width="200" VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                                DayVisible="{x:Bind ViewModel.IsDayVisible, Mode=OneWay}"
                                MonthVisible="{x:Bind ViewModel.IsMonthVisible, Mode=OneWay}" />
                    <TextBlock Text="to" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                                DayVisible="{x:Bind ViewModel.IsDayVisible, Mode=OneWay}"
                                MonthVisible="{x:Bind ViewModel.IsMonthVisible, Mode=OneWay}" />
                </StackPanel>
                
                <Button Content="✨ AI Assistant" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenChatCommand}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>


        </StackPanel>

        <!-- Charts Grid -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Line Chart: Products & Sales -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Products &amp; Sales Quantity" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                    
                    <!-- Product Search and Active Filters -->
                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="12" Margin="0,0,0,16">
                        <AutoSuggestBox x:Name="ProductSearchBox"
                                        PlaceholderText="Search product to compare..."
                                        HorizontalAlignment="Stretch"
                                        TextChanged="ProductSearchBox_TextChanged"
                                        SuggestionChosen="ProductSearchBox_SuggestionChosen"
                                        DisplayMemberPath="Name"
                                        TextMemberPath="Name"
                                        UpdateTextOnSelect="False"/>

                        <ScrollViewer x:Name="ProductTagsScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" PointerPressed="ProductTagsScrollViewer_PointerPressed" PointerMoved="ProductTagsScrollViewer_PointerMoved" PointerReleased="ProductTagsScrollViewer_PointerReleased" PointerCanceled="ProductTagsScrollViewer_PointerReleased">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveProducts, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Product">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Background="Transparent" BorderThickness="0" 
                                                        Padding="4" MinWidth="0" MinHeight="0"
                                                        VerticalAlignment="Center"
                                                        Click="RemoveFilter_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="2" 
                                        Series="{x:Bind ViewModel.SalesSeries, Mode=OneWay}" 
                                        XAxes="{x:Bind ViewModel.SalesXAxes, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Bar Chart: Revenue & Profit -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Revenue &amp; Profit" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                    <lvc:CartesianChart Grid.Row="1" 
                                        Series="{x:Bind ViewModel.RevenueSeries, Mode=OneWay}"
                                        XAxes="{x:Bind ViewModel.RevenueXAxes, Mode=OneWay}"/>
                </Grid>
            </Border>
        </Grid>


        </Grid>
        </SplitView.Content>
    </SplitView>
</Page>
