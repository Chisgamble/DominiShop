<Page
    x:Class="DominiShop.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Padding="40" Spacing="20" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>

        <Expander Header="Pagination Settings" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="15" Margin="0,10,0,0">

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Product Items Per Page" FontWeight="SemiBold"/>
                        <TextBlock Text="Number of products displayed in the inventory list." FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="100" ItemsSource="{x:Bind ViewModel.PageSizeOptions}" 
                              SelectedItem="{x:Bind ViewModel.ProductPageSize, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Category Items Per Page" FontWeight="SemiBold"/>
                        <TextBlock Text="Number of categories displayed per page." FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="100" ItemsSource="{x:Bind ViewModel.PageSizeOptions}" 
                              SelectedItem="{x:Bind ViewModel.CategoryPageSize, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Customer Items Per Page" FontWeight="SemiBold"/>
                        <TextBlock Text="Number of customers displayed in the list." FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="100" ItemsSource="{x:Bind ViewModel.PageSizeOptions}" 
                              SelectedItem="{x:Bind ViewModel.CustomerPageSize, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tax Items Per Page" FontWeight="SemiBold"/>
                        <TextBlock Text="Number of tax rules displayed per page." FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="100" ItemsSource="{x:Bind ViewModel.PageSizeOptions}" 
                              SelectedItem="{x:Bind ViewModel.TaxPageSize, Mode=TwoWay}"/>
                </Grid>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Order Items Per Page" FontWeight="SemiBold"/>
                        <TextBlock Text="Number of orders displayed in the history list." FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="100" ItemsSource="{x:Bind ViewModel.PageSizeOptions}" 
              SelectedItem="{x:Bind ViewModel.OrderPageSize, Mode=TwoWay}"/>
                </Grid>

            </StackPanel>
        </Expander>

        <InfoBar IsOpen="True" Severity="Informational" Title="Tip" 
                 Message="These settings are saved automatically and applied immediately upon returning to the respective pages."
                 IsClosable="False"/>
    </StackPanel>
</Page>