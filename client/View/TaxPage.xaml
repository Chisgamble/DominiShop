<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DominiShop.View.TaxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:DominiShop.Model"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:conv="using:DominiShop.Converter"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:TaxValueConverter x:Key="TaxValueConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0" x:Name="GlobalInfoBar"
             IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
             Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
             Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- Header -->
        <RelativePanel Grid.Row="1" Margin="0,0,0,24">
            <TextBlock Text="Tax Management" Style="{StaticResource TitleTextBlockStyle}" RelativePanel.AlignLeftWithPanel="True"/>
            <Button Click="AddNew_Click" 
                    Style="{StaticResource AccentButtonStyle}" RelativePanel.AlignRightWithPanel="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="Add New Tax"/>
                </StackPanel>
            </Button>
        </RelativePanel>

        <!-- Filter Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <ComboBox Header="Type" ItemsSource="{x:Bind ViewModel.TaxTypes}" 
                      SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}" Width="150"/>
            <ComboBox Header="Sort by" ItemsSource="{x:Bind ViewModel.SortOptions}" 
                      SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" Width="180"/>
            <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.LoadDataCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <controls:DataGrid
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.Taxes, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedTax, Mode=TwoWay}"
            AutoGenerateColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            SelectionMode="Single"
            CanUserSortColumns="True"
            RowHeight="52"
            HorizontalAlignment="Stretch">

            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>

                <controls:DataGridTemplateColumn Header="Tax Name" Width="2*">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:Tax">
                            <TextBlock Text="{x:Bind Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Header="Type" Width="1.2*">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:Tax">
                            <TextBlock Text="{x:Bind Type}"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Header="Value" Width="0.8*">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:Tax">
                            <TextBlock Text="{Binding Converter={StaticResource TaxValueConverter}}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemAccentColor}"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Header="Auto Apply" Width="170">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:Tax">
                            <ToggleSwitch IsOn="{x:Bind IsAutoApply, Mode=OneWay}"
                                          Toggled="AutoApplyToggle_Toggled"
                                          OnContent="Yes"
                                          OffContent="No"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn Header="" Width="100">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:Tax">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Click="EditButton_Click"
                                        ToolTipService.ToolTip="Edit">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                </Button>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Click="DeleteButton_Click"
                                        ToolTipService.ToolTip="Delete">
                                    <FontIcon Glyph="&#xE74D;"
                                              FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- Edit/Add Overlay (Simple Dialog simulation) -->
        <ContentDialog x:Name="EditDialog" 
               Title="Tax Details" 
               PrimaryButtonText="Save" 
               CloseButtonText="Cancel"
               DefaultButton="Primary"
               PrimaryButtonClick="EditDialog_PrimaryButtonClick">
            <StackPanel Spacing="12" Width="300">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="False" />
                <TextBox Header="Tax Name" Text="{x:Bind ViewModel.EditingTax.Name, Mode=TwoWay}"/>
                <ComboBox Header="Type" SelectedItem="{x:Bind ViewModel.EditingTax.Type, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <x:String>Percentage</x:String>
                    <x:String>Fixed Amount</x:String>
                </ComboBox>
                <NumberBox Header="Value" Value="{x:Bind ViewModel.EditingTax.ValueAsDouble, Mode=TwoWay}" 
                           SpinButtonPlacementMode="Inline" SmallChange="1" PlaceholderText="0.00"/>
                <ToggleSwitch Header="Auto Apply"
                              IsOn="{x:Bind ViewModel.EditingTax.IsAutoApply, Mode=TwoWay}"
                              OnContent="Yes"
                              OffContent="No"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
